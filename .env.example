# 실제 값이 담긴 .env* 파일은 절대 커밋하지 않는다. (기획서 12. 보안·안전)

# ── 카카오톡 공유 (선택) ────────────────────────────────
# 없으면 Web Share API → 링크 복사 순으로 자동 대체된다.
NEXT_PUBLIC_KAKAO_JS_KEY=

# ── Supabase (Auth / DB / Storage) ─────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 절대 NEXT_PUBLIC_ 접두사를 붙이지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# ── 이미지 생성 AI (서버 전용) ──────────────────────────
# baseline provider 는 Gemini Image API 이며, AI 담당자가 교체 실험할 수 있다.
GEMINI_API_KEY=
