# Backend(GoldenLook-Backend) 배포 origin. 비워 두면 같은 origin 으로 요청한다.
NEXT_PUBLIC_API_BASE_URL=

# Supabase Auth (Email/Password). anon key 와 URL 만 둔다.
# Service Role / Gemini key 는 Backend 전용이며 브라우저 번들에 들어가면 안 된다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 카카오 JavaScript 키. 없으면 기본 공유 시트 → 링크 복사로 대체된다.
NEXT_PUBLIC_KAKAO_JS_KEY=

# 공유 링크에 쓰는 Frontend 배포 주소 (예: https://goldenlook.vercel.app)
NEXT_PUBLIC_BASE_URL=
